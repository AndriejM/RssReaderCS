{
  "manifest_version": 3,
  "name": "RssReader Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Polls the RssReader backend for unread items, shows a badge, plays a sound, sends notifications, and opens the frontend.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open RssReader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
